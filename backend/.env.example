# Qube.AI Backend Environment Configuration
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=Qube.AI
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Update these with your actual PostgreSQL credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qubeai
DB_USER=postgres
DB_PASSWORD=newpassword123

# Security
# Generate a secure secret key for production (min 32 characters)
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama2

# Vector Database
CHROMA_DB_PATH=./data/chroma_db

# Logging
LOG_LEVEL=INFO

# CORS (NEW - add this)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]