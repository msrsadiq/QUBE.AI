# Database
DATABASE_URL=postgresql://user:password@localhost:5432/qubeai

# LLM Configuration (Model Agnostic)
LLM_PROVIDER=openai  # or 'anthropic', 'huggingface', 'ollama'
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=http://localhost:11434  # For Ollama

# Vector Database for RAG
VECTOR_DB_TYPE=chromadb  # or 'qdrant', 'weaviate'
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_COLLECTION=qe_copilot

# Redis for caching
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO